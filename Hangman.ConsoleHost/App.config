<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<configSections>
		<section name="entityFramework"
				 type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"
				 requirePermission="false" />
	</configSections>

	<appSettings file="AppSettings.local.config">
		<add key="Auth.PasswordSaltSize" value="16" />
		<add key="Auth.PasswordHashSize" value="32" />
		<add key="Auth.PasswordIterations" value="10000" />
		<add key="Auth.VerificationCodeLength" value="6" />
		<add key="Auth.VerificationCodeLimit" value="1000000" />
		<add key="Auth.EmailVerificationExpirationMinutes" value="15" />
		<add key="Auth.MinimumPasswordLength" value="8" />
		<add key="Auth.MaximumVerificationAttempts" value="5" />
		<add key="Auth.DefaultLanguageCode" value="es" />
		<add key="Auth.AllowedLanguageCodes" value="es,en" />
	</appSettings>

	<connectionStrings configSource="ConnectionStrings.local.config" />

	<startup>
		<supportedRuntime version="v4.0"
						  sku=".NETFramework,Version=v4.7.2" />
	</startup>

	<entityFramework>
		<providers>
			<provider invariantName="System.Data.SqlClient"
					  type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
		</providers>
	</entityFramework>
</configuration>